[Unit]
Description=Ayatori k0s 备份（etcd、PKI、k0s.yaml）
After=k0scontroller.service
RequiresMountsFor={{ backup_dir }}

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/local/bin/k0s backup --save-path={{ backup_dir }}
# 只保留最新 {{ backup_keep }} 份。
ExecStartPost=/bin/sh -c 'ls -1t {{ backup_dir }}/k0s_backup_*.tar.gz | tail -n +{{ backup_keep + 1 }} | xargs -r rm -f --'
# 供 node_exporter textfile collector 判断备份新鲜度；只在成功后更新。
ExecStartPost=/bin/sh -c 'f={{ node_exporter_textfile_dir }}/ayatori_backup.prom; printf "%%s\n" "# HELP ayatori_backup_last_success_timestamp_seconds 最近一次 k0s backup 成功完成的时间。" "# TYPE ayatori_backup_last_success_timestamp_seconds gauge" "ayatori_backup_last_success_timestamp_seconds $$(date +%%s)" > $$f.tmp && chmod 0644 $$f.tmp && mv $$f.tmp $$f'
