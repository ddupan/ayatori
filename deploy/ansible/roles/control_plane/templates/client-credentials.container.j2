[Unit]
Description=client-credentials ({{ inventory_hostname }})
After=k0scontroller.service network-online.target
Wants=network-online.target

# 以 root 运行：替各身份写入属于该身份的证书文件；只保留写文件所需的权限。
[Container]
Image={{ ayatori_image }}
PodmanArgs=--entrypoint=/client-credentials
Network=host
ReadOnly=true
User=0
NoNewPrivileges=true
DropCapability=ALL
AddCapability=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER
Volume={{ identities_dir }}:/identities
Exec={% for i in identities %}--identity={{ i.name }}=/identities/{{ i.name }} {% endfor %}


[Service]
Restart=on-failure
RestartSec=10
MemoryMax=64M

[Install]
WantedBy=multi-user.target
