[Unit]
Description={{ item.name }} ({{ inventory_hostname }})
After=k0scontroller.service network-online.target
Wants=network-online.target

[Container]
Image={{ item.image }}
Network=host
ReadOnly=true
Tmpfs=/tmp
User={{ (identities | selectattr('name', 'equalto', item.identity) | first).uid }}
NoNewPrivileges=true
DropCapability=ALL
Volume={{ identities_dir }}/{{ item.identity }}:/identity:ro
Environment=KUBECONFIG=/identity/kubeconfig
{% for k, v in (item.env | default({})).items() %}
Environment={{ k }}={{ v }}
{% endfor %}
{% for v in item.volumes | default([]) %}
Volume={{ v }}
{% endfor %}
Exec={{ item.args | join(' ') }}

[Service]
Restart=on-failure
RestartSec=10
MemoryMax={{ item.memory }}

[Install]
WantedBy=multi-user.target
