apiVersion: v1
kind: Namespace
metadata:
  name: flux-system
---
apiVersion: v1
kind: Namespace
metadata:
  name: {{ control_namespace }}
---
# source-controller 只管理 Source 对象并读取其引用的 Secret/ConfigMap。
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: flux-source-controller
rules:
- apiGroups: [source.toolkit.fluxcd.io]
  resources: ["*"]
  verbs: ["*"]
- apiGroups: [""]
  resources: [secrets, configmaps]
  verbs: [get, list, watch]
- apiGroups: ["", events.k8s.io]
  resources: [events]
  verbs: [create, patch]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: flux-source-controller
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: flux-source-controller
subjects:
- kind: User
  apiGroup: rbac.authorization.k8s.io
  name: flux-source-controller
---
# kustomize-controller 应用 CRD、RBAC 等任意清单，与上游安装一致使用 cluster-admin。
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: flux-kustomize-controller
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: cluster-admin
subjects:
- kind: User
  apiGroup: rbac.authorization.k8s.io
  name: flux-kustomize-controller
---
# ESO 以 --namespace 运行，上游 ClusterRole 只在本 namespace 内生效。
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: external-secrets-controller
  namespace: {{ control_namespace }}
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: external-secrets-controller
subjects:
- kind: User
  apiGroup: rbac.authorization.k8s.io
  name: external-secrets
---
# 环境只跟随本 role 所属 release 的 tag，不跟随 main。
apiVersion: source.toolkit.fluxcd.io/v1
kind: GitRepository
metadata:
  name: ayatori
  namespace: flux-system
spec:
  interval: 10m
  url: {{ ayatori_repository }}
  ref:
    tag: {{ ayatori_version }}
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: ayatori-crds
  namespace: flux-system
spec:
  interval: 10m
  sourceRef:
    kind: GitRepository
    name: ayatori
  path: ./deploy/flux/crds
  prune: false
---
apiVersion: kustomize.toolkit.fluxcd.io/v1
kind: Kustomization
metadata:
  name: ayatori-control-plane
  namespace: flux-system
spec:
  interval: 10m
  dependsOn:
  - name: ayatori-crds
  sourceRef:
    kind: GitRepository
    name: ayatori
  path: ./deploy/flux/control-plane
  prune: true
  postBuild:
    substitute:
      OPENBAO_KUBERNETES_MOUNT: {{ openbao_kubernetes_mount | to_json }}
      OPENBAO_EXTERNAL_SECRETS_ROLE: {{ openbao_external_secrets_role | to_json }}
      MANAGEMENT_CREDENTIAL_PATH: {{ management_credential_path | to_json }}
      POSTGRESQL_INSTANCE: {{ ayatori_postgresql_instance.name | to_json }}
      POSTGRESQL_HOST: {{ ayatori_postgresql_instance.host | to_json }}
      POSTGRESQL_HOSTADDR: {{ ayatori_postgresql_instance.hostaddr | to_json }}
      POSTGRESQL_PORT: "{{ ayatori_postgresql_instance.port }}"
