{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "postUpdateOptions": ["gomodTidy"],
  "labels": ["dependencies"],
  "gitIgnoredAuthors": ["360661234+ddupan-bot[bot]@users.noreply.github.com"],
  "customManagers": [
    {
      "description": "Makefile 里 go install / 下载的工具版本：在 `<NAME>_VERSION ?=` 上一行写 `# renovate: datasource=<ds> depName=<name>`。",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Makefile$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\S+_VERSION \\?= (?<currentValue>\\S+)"]
    }
  ],
  "packageRules": [
    {
      "description": "k8s.io 各模块与 controller-runtime 的次版本互相绑定；envtest 版本由 go.mod 推导，随之更新。",
      "matchDatasources": ["go"],
      "matchPackageNames": ["k8s.io/**", "sigs.k8s.io/controller-runtime"],
      "groupName": "kubernetes"
    },
    {
      "description": "go.mod 的 go 指令与构建镜像一起升级，避免本地、CI 与镜像的工具链不一致。",
      "matchDepNames": ["go", "golang"],
      "groupName": "go toolchain"
    },
    {
      "description": "go 指令是最低版本约束，默认策略下新补丁版本已满足约束而不会更新；bump 让它与镜像一起升到新版本。",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    }
  ]
}
